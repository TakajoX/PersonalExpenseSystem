{
    "name": "Python Console App",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // AGGIUNTO: Abilita Docker all'interno del Dev Container
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    // Configura le impostazioni specifiche di VS Code nel container
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "njpwerner.autodocstring",
                "kevinrose.vsc-python-indent"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.linting.enabled": true,
                "editor.formatOnSave": true
            }
        }
    },
    // Usa 'postCreateCommand' per installare le librerie all'avvio
    "postCreateCommand": "pip install -r requirements.txt",
    // Fa girare il container come utente non-root per sicurezza
    "remoteUser": "vscode"
}